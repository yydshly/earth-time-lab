# Optional LOCAL dynamic voice configuration only. No API key is included.
# The GitHub Pages site uses recorded audio and needs no environment variables or key.
# server.mjs does not automatically load a .env file. Set values in your local shell,
# or use MINIMAX_CONFIG_PATH to point at a private dotenv file outside this repository.
PORT=4318
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.cn
MINIMAX_MODEL=speech-2.8-hd
MINIMAX_VOICE_ID="Chinese (Mandarin)_Gentleman"

# Optional local alternative: point to a private dotenv file with an absolute path.
# Keep the actual file outside dist/ and outside version control.
# MINIMAX_CONFIG_PATH=C:/path/to/private/.env.minimax
